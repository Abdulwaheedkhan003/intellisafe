# ============================================================
# THREATLENS — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────
# 32+ character random secret for encrypting OAuth tokens in DB
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
THREATLENS_SECRET=change-me-to-a-32-char-random-secret-key

# ── Gemini AI ────────────────────────────────────────────────
# Get free key: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=

# ── Google OAuth (Gmail) ──────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Enable: Gmail API
# Redirect URI to register: http://localhost:3000/api/gmail/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Threat Intelligence (optional) ───────────────────────────
# VirusTotal free tier: https://www.virustotal.com/gui/join-us (4 req/min)
VIRUSTOTAL_API_KEY=

# ── Gmail Polling ─────────────────────────────────────────────
GMAIL_POLL_INTERVAL_MS=15000
